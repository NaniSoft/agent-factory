<Project>

  <!--
    One place every package version lives. `Temporalio` was declared twice by hand
    at the same version, which is the kind of agreement that survives exactly until
    one of the two is edited. A project then says which packages it uses and
    `Directory.Packages.props` says which versions they are.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="The factory">
    <!--
      The one package two of the three libraries take — `Application` for
      `WorkItemScope`/`ProjectScope` and `Infrastructure` for the result deriver — and the
      reason a record can be written from either: `ILogger<T>` is how that is expressed.
      `Microsoft.NET.Sdk` and the Web SDK carry it implicitly; the libraries carry nothing,
      so it is declared. It is the abstractions and not the whole logging stack, because a
      scope opens a record and does not choose where the record goes — which is #63's, on
      the far side of the boundary. `Domain` takes nothing, ever.
    -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <!--
      `FactoryDriver` is the heartbeat: a `BackgroundService` whose whole body is one
      `Task.Delay` and two calls into the policy core. It is the only hosted service in
      `Application`, and `BackgroundService`/`IHostedService` live here. It is the same
      kind of package as the logging abstractions — the framework's own contract for being
      run and stopped, carrying no adapter and reaching nothing outside — not a transport,
      a disk, a process or a credential.
    -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
    <!--
      `TemporalTickets` resolves the store, the policy core and its own logger from the
      container as it hosts the worker, so `Infrastructure` names `IServiceProvider`'s own
      extension. The Web SDK carries this package implicitly and `Microsoft.NET.Sdk` does
      not, so it is declared rather than assumed — the same kind of reference as the
      hosting abstractions above, and declared with it for the same reason.
    -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <!--
      `FactoryPaths` and `FactorySettings` read a configuration key before they resolve
      anything on a disk, so this project names `IConfiguration` and declares the
      abstractions for it. `Application` does not: `FactoryOptions` is the values, and
      nothing in the policy reads a key.
    -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
    <!--
      The raw provider, and it is still referenced by `AgentFactory.Web` while the
      hand-written ADO.NET store is there. It is bumped to the 10.0.13 patch line with the
      rest: EF brings `Microsoft.Data.Sqlite.Core` 10.0.13 transitively, and a direct
      reference left at 10.0.12 splits the package across two versions.
    -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <!--
      The store of record over EF Core, on SQLite. `Infrastructure` owns the model — the
      `DbContext`, its row types and every mapping — and `Application` names none of it:
      `IWorkItemStore` is still a port, and this is the adapter behind it (#56, #62).
      **EF 10.0.13 requires the `Microsoft.Extensions.*` abstractions at 10.0.13**, so the
      four above move with it in the same change: holding them at 10.0.12 is a package
      downgrade, which this repository's `TreatWarningsAsErrors` refuses as NU1605 rather
      than letting it pass as a warning.
    -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <!--
      Required only by `dotnet ef`, which is the tool that generates the baseline
      migration, so it is a `PrivateAssets=all` reference in `Infrastructure` and travels
      nowhere. It is pinned to the same version as the provider because EF's tooling checks
      the tool and the runtime versions against each other.
    -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Temporalio" Version="1.20.0" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup Label="The suite">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!--
    `Testcontainers` was declared by the test project and used by nothing. It drove
    the worker-image tests, which ADR-0016 deleted along with the worker image, and
    the only mention left in the suite is the assertion in `RoundTests` that the
    factory takes no container-runtime package at all — which the reference was
    contradicting. It goes with the ADR that stranded it.
  -->

</Project>