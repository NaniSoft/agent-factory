{
  "name": "@nanisoft/agent-factory-admin",
  "version": "0.0.0",
  "private": true,
  "description": "The agent factory's Board, rendered with Prism and served statically at the root over the factory's own loopback JSON API.",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
