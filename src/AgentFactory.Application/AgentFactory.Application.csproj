<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The factory's policy, and its seams. `Orchestrator`, `Poller`, `FactoryDriver`, the
    eight ports, the merge policy and the Routes/Api projections. It names Domain because
    it decides things about the factory's own vocabulary, and it names nothing outside
    itself: an implementation is somebody else's problem and arrives through a port
    (docs/architecture.md, "The dependency rule").

    Everything else shared is in Directory.Build.props. Package versions are in
    Directory.Packages.props.
  -->

  <PropertyGroup>
    <RootNamespace>AgentFactory.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The one edge inward, and it is a project reference because Domain is a project. -->
    <ProjectReference Include="..\AgentFactory.Domain\AgentFactory.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      `WorkItemScope` and `ProjectScope` put a work item's or a project's identity on every
      record written inside them, and `ILogger<T>` is the only way this factory expresses
      that. The Web SDK carries this package implicitly and `Microsoft.NET.Sdk` does not, so
      it is declared rather than assumed — the reference `docs/architecture.md` says
      Application and Infrastructure both take when they first need one.
    -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!--
      `FactoryDriver` is a `BackgroundService`, and that is a hosting abstraction the Web
      SDK carries implicitly and `Microsoft.NET.Sdk` does not. It is the same kind of
      reference as the logging abstractions above: the framework's contract for a long-
      running task, not an adapter — the driver reaches no transport, disk or process.
    -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <!--
      `ITicketActivities` is the one inbound port in this project — the durable workflow
      lives outside and drives the factory through it — and the engine requires its
      `[Activity]` names on the very methods the workflow invokes (`ActivityDefinition.
      NameFromMethodForCall` throws without one), so the port cannot be declared without
      the engine's own vocabulary. Two alternatives were tried and refused: an
      attribute-free port does not work at all, and moving the attributes to
      `TicketActivities` would make the workflow call the concrete adapter and leave the
      port decorative. **This is a correction to `docs/architecture.md`'s dependency rule
      rather than an oversight** — `Application` takes the engine here for exactly one
      interface and the same reason it already takes the hosting abstractions for
      `FactoryDriver`; nothing in the policy core names a Temporalio type.
    -->
    <PackageReference Include="Temporalio" />
  </ItemGroup>

</Project>