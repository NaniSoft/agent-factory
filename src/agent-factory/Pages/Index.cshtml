@page "/"
@model IndexModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Agent Factory — board@(Model.Project is { Length: > 0 } p ? $" — {p}" : "")</title>
    <link rel="stylesheet" href="~/board.css" />
</head>
<body>
    <header>
        <h1>Agent Factory</h1>
        @* The feedback threshold, stated on the board rather than buried in code — along
            with whether it is live. A reviewer must never wonder whether the absence of
            their decision can ship a change, so the mode is named in the same breath as
            the threshold it governs. *@
        <p class="feedback-threshold"
           data-feedback-threshold="threshold"
           data-hours="@FactoryConstants.FeedbackThreshold.TotalHours"
           data-merges-unattended="@(Model.MergesUnattended ? "on" : "off")">
            @if (Model.MergesUnattended)
            {
                <text>A work item left in <strong>Review</strong> for @FactoryConstants.FeedbackThresholdText
                is <strong>merged</strong> without a review. Ignoring a work item merges it; actively
                declining one protects the repository. A work item out of rounds is
                <strong>escalated</strong>, never merged.</text>
            }
            else
            {
                <text>Auto-merge is <strong>off</strong>: a work item left in <strong>Review</strong>
                waits for a decision, however long it takes. Nothing merges unattended; actively
                declining one protects the repository. A work item out of rounds is
                <strong>escalated</strong>, never merged.</text>
            }
        </p>

        <p class="served-projects">
            Serving
            @if (Model.Projects.Count == 0)
            {
                <span>no projects</span>
            }
            else
            {
                <span>@Model.Projects.Count project@(Model.Projects.Count == 1 ? "" : "s")</span>
                <ul>
                    @foreach (var project in Model.Projects)
                    {
                        <li data-served-project="@project.Name"
                            data-repo-url="@project.RepoUrl"
                            data-worker-image="@project.WorkerImage"
                            data-llm-model="@project.LlmModel"
                            data-github-key="@project.GitHubKeyName"
                            data-llm-key="@project.LlmKeyName"
                            title="@project.SourceFile">
                            <strong>@project.Name</strong>
                            <span>@project.RepoUrl</span>
                            <span>worker @project.WorkerImage</span>
                            <span>llm @project.LlmModel</span>
                            <span>keys @project.GitHubKeyName, @project.LlmKeyName</span>
                        </li>
                    }
                </ul>
            }
        </p>

        @* The container budget, on the board rather than only in a constant: a reviewer
            watching a work item sit in Frontier is asking whether the factory is working or
            wedged, and this is the answer. Bounded and saying so is what makes the wait
            readable — a work item in Frontier behind a full budget is queued, and one behind
            an empty one would be a fault worth seeing. *@
        <p class="container-budget"
           data-container-budget="budget"
           data-budget="@FactoryConstants.ContainerBudget"
           data-in-flight="@Model.RoundsInFlight">
            @Model.RoundsInFlight of @FactoryConstants.ContainerBudget worker containers in use.
            A work item in <strong>Frontier</strong> is waiting for a container, not for a
            decision — each round gets its own, whatever project it is for.
        </p>
    </header>

    <main>
        @* Grouping and filtering by project. A GET and a query string, so it is a way of
            looking at the board rather than a write path: the filter changes what is
            rendered and nothing else, and every decision the board offers is offered on
            exactly the same terms whatever is showing. Every project is always offered,
            including the one currently in force, so a reviewer can get back to the whole
            board without a browser's back button. *@
        <nav class="project-filter" data-project-filter="filter">
            <a href="/" data-project-filtered="" data-current="@(Model.Project is not { Length: > 0 } ? "true" : "false")">All projects</a>
            @foreach (var project in Model.ProjectsOnTheBoard)
            {
                var current = Model.Project == project;
                <a href="/?project=@Uri.EscapeDataString(project)"
                   data-project-filtered="@project"
                   data-current="@(current ? "true" : "false")">@project</a>
            }
        </nav>

        @if (Model.Refusal is { Length: > 0 })
        {
            <p class="refusal" data-refusal="the decision was refused">@Model.Refusal</p>
        }

        @* Intake, always, and first. *@

        @* Intake is the one thing on this board a reviewer trusts before anything else:
            every lane below it was filled by it. So it is rendered in three states rather
            than as the presence or absence of work items, because an empty Backlog is
            three different facts — the repository was read and had nothing open, the
            factory has never read it, or the factory tried and was refused — and the
            third is a fault the reviewer has to see before they read anything else as
            "there is nothing to do".

            Rendered when the factory serves a project, healthy or not. A section that only
            appears when something is wrong is a section whose absence carries no
            information, which is the same argument the container budget makes by always
            stating its bound.

            Every served project is on it whatever the filter is, and that is deliberate
            the other way round from the lanes: a filter narrows what a reviewer is looking
            at, and a fault in the machine is not a view of it. Hiding a failing project
            behind a filter would be a filter that could hide the reason there is nothing
            on the board. *@
        @{
            var intake = Model.Intake;
            var intakePolled = intake.Count(project => project.Status == IntakeStatus.Polled);
            var intakeNeverPolled = intake.Count(project => project.Status == IntakeStatus.NeverPolled);
            var intakeFailing = intake.Count(project => project.Status == IntakeStatus.Failing);
        }
        @if (intake.Count > 0)
        {
            <section class="intake"
                     data-intake="intake"
                     data-intake-state="@HowToReadIntake.Slug(HowToReadIntake.WorstOf(intake))"
                     data-projects="@intake.Count"
                     data-polled="@intakePolled"
                     data-never-polled="@intakeNeverPolled"
                     data-failing="@intakeFailing">
                <h2>Intake</h2>
                <p class="intake-summary" data-intake-summary="intake">@HowToReadIntake.Summarise(intake)</p>
                <ul>
                    @foreach (var project in intake)
                    {
                        <li class="intake-project"
                            data-intake-project="@project.Project"
                            data-intake-state="@HowToReadIntake.Slug(project.Status)"
                            data-repo-url="@project.RepoUrl"
                            data-open-issues="@(project.OpenIssues?.ToString() ?? string.Empty)"
                            data-classification="@(project.Failure?.ToString() ?? string.Empty)"
                            data-failures="@project.Failures"
                            data-polled-at="@(project.AtUtc?.ToString("O") ?? string.Empty)"
                            data-again="@project.Again">
                            <strong>@project.Project</strong>
                            <span class="repository">@project.RepoUrl</span>
                            <span class="state">@project.Says</span>
                        </li>
                    }
                </ul>
            </section>
        }

        @if (Model.Rejections.Count > 0)
        {
            <section class="refused-project-files">
                <h2>Project files refused</h2>
                <ul>
                    @foreach (var rejection in Model.Rejections)
                    {
                        <li data-refused-file="@rejection.FileName" data-reason="@rejection.Reason">
                            <strong>@rejection.FileName</strong>
                            <span class="reason">@rejection.Reason</span>
                            <span class="message">@rejection.Message</span>
                        </li>
                    }
                </ul>
            </section>
        }

        @* Stated on the board rather than only in the filter's own markup, because a filter
            naming a project the factory is not serving narrows the board to nothing and a
            reviewer looking at an empty board has to be able to tell "this project has
            nothing waiting" from "the factory does not know that project". *@
        @if (Model.Project is { Length: > 0 } narrowed)
        {
            <p class="project-in-force" data-project-in-force="@narrowed" data-known="@(Model.ProjectsOnTheBoard.Contains(narrowed, StringComparer.Ordinal) ? "true" : "false")">
                Showing @narrowed.
                @if (!Model.ProjectsOnTheBoard.Contains(narrowed, StringComparer.Ordinal))
                {
                    <span>The factory has never heard of it: no project by that name is being served and none has work waiting.</span>
                }
            </p>
        }

        <section class="board" data-board-projects="@(Model.Project ?? string.Empty)">
            @foreach (var swimlane in Swimlanes.All.Concat(Swimlanes.ParkedAndFinal))
            {
                var items = Model.WorkItems.Where(workItem => workItem.Swimlane == swimlane).ToList();
                <div class="swimlane @(swimlane is Swimlane.Escalated or Swimlane.Rejected ? "parked-and-final" : null)"
                     data-swimlane="@swimlane">
                    <h2>@Swimlanes.Label(swimlane)</h2>
                    @* Grouped by project inside the lane, which is the one axis the
                        swimlane is not. A lane is a state and every project shares them;
                        the question a reviewer asks of a lane with nine cards on it is
                        which of them are theirs, and grouping answers it without a filter
                        and without reading each card. Oldest first within a group, which
                        is the store's own order, so a project's queue reads in the order
                        it was picked up. *@
                    @foreach (var group in items
                        .GroupBy(workItem => workItem.Project, StringComparer.Ordinal)
                        .OrderBy(group => group.Key, StringComparer.OrdinalIgnoreCase))
                    {
                        <section class="project-group" data-project-group="@group.Key" data-project-count="@group.Count()">
                            <h3>@group.Key <span class="count">@group.Count()</span></h3>
                            <ul>
                                @foreach (var workItem in group)
                                {
                                    await RenderCardAsync(workItem);
                                }
                            </ul>
                        </section>
                    }
                </div>
            }
        </section>
    </main>

    @* Auto-refresh: a board a reviewer has to refresh by hand is a board they stop trusting. The
        filter rides through a reload, because a board that forgets which project you asked
        for is a board you have to set up again every five seconds.

        A fold that closes itself every five seconds is not a fold, though. A reviewer reading
        a diff opens the files they care about, and the reload is going to happen underneath
        them whether or not they are ready for it. So which sections a reviewer has opened is
        remembered in the tab and restored on the way back in.

        The key is rendered by the board rather than assembled in the script, because the
        board is the only thing that knows which work item and which round a section belongs
        to — and because a key that is <em>one</em> attribute is a key the script cannot get
        subtly wrong. It is the work item, the round and the file's path: all three, so that
        opening a file in round 1 does not also open round 2's copy of a file of the same
        name, which is a different change.

        Which is all the JavaScript on this board does besides the reload itself. It writes
        nothing to the server, has no endpoint of its own and cannot change a work item: the
        board's only write path is the reviewer's three decisions, and this is not one
        (ADR-0005, ADR-0008). *@
    <script>
        (function () {
            const seconds = @FactoryConstants.BoardAutoRefreshSeconds;
            const project = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Project ?? ""));
            const url = project ? "/?project=" + encodeURIComponent(project) : "/";
            const storage = "agent-factory:open-diffs";
            const sections = "details[data-open-key]";

            try {
                (window.sessionStorage.getItem(storage) || "").split("\n").filter(Boolean).forEach(function (key) {
                    const section = document.querySelector(sections + '[data-open-key="' + key + '"]');
                    if (section) { section.open = true; }
                });
            } catch (ignored) {
                // A browser with no session storage still refreshes. It just forgets.
            }

            window.setInterval(function () {
                try {
                    const open = Array.prototype.map.call(
                        document.querySelectorAll(sections + "[open]"),
                        function (section) { return section.dataset.openKey; });
                    window.sessionStorage.setItem(storage, open.join("\n"));
                } catch (ignored) {
                    // As above: a fold that cannot be remembered is a fold, not a fault.
                }

                window.location.replace(url);
            }, seconds * 1000);
        })();
    </script>
</body>
</html>

@{
    // One card. A local function rather than a partial because a card is the board's
    // markup and the board is one page: splitting it would put a work item's whole record
    // — its rounds, its decisions, its cause and its decision form — behind an include
    // boundary for no gain.
    async Task RenderCardAsync(WorkItem workItem)
    {
        var rounds = Model.RoundsOf(workItem.Id);
        var decisions = Model.DecisionsOf(workItem.Id);

        // Why it ended, for the lanes that are an ending. Escalated and Rejected are two
        // states with two distinct causes, so the card says which one this is rather than
        // leaving two lanes whose cards read alike.
        var cause = Model.CauseOf(workItem);

        // When this card's silence would ship it, on the card itself rather than only in
        // the header, because a timeout a reviewer cannot see per work item is a timeout
        // they cannot act on while it still matters. With auto-merge off there is nothing
        // a countdown could say, so the attribute is not written at all — an empty
        // countdown would read as a promise waiting for a value.
        var workspace = Model.WorkspaceFor(workItem.Id);

var mergesAt = Model.AutoMergeAt(workItem);
        var autoMergeAttribute = mergesAt is { } shipsAt ? $@" data-auto-merge=""{shipsAt:O}""" : string.Empty;
        <li class="work-item"
            data-work-item="@workItem.Id"
            data-project="@workItem.Project"
            data-issue="@workItem.IssueNumber"
            data-base-branch="@workItem.BaseBranch"
            data-round-count="@workItem.RoundCount"
            data-rounds="@rounds.Count"
            data-decisions="@decisions.Count"
            data-merge-attempts="@workItem.MergeAttempts"
            data-cause="@cause"@Html.Raw(autoMergeAttribute)>
            <span class="project">@workItem.Project</span>
            <span class="issue">#@workItem.IssueNumber @workItem.IssueTitle</span>
            <span class="base-branch">base @workItem.BaseBranch</span>
            <span class="round-count">round @workItem.RoundCount of @FactoryConstants.RoundCeiling</span>
            @if (cause.Length > 0)
            {
                <span class="cause">@cause</span>
            }
            @if (mergesAt is { } when)
            {
                <span class="auto-merge">
                    auto-merges at @when.ToString("yyyy-MM-dd HH:mm 'UTC'")
                    unless a reviewer decides first
                </span>
            }
            @if (rounds.Count > 0)
            {
                <ol class="rounds">
                    @foreach (var round in rounds)
                    {
                        <li class="round"
                            data-round="@round.RoundNumber"
                            data-outcome="@round.Outcome"
                            data-failure="@(round.Failure?.ToString() ?? string.Empty)"
                            data-attempts="@round.Attempts"
                            data-has-result="@(round.ResultPayload is { Length: > 0 } ? "true" : "false")"
                            data-has-log="@(round.Log is { Length: > 0 } ? "true" : "false")"
                            data-has-diff="@(round.HasADiff ? "true" : "false")"
                            data-diff-state="@((Model.DiffOf(round)?.State.ToString() ?? "none").ToLowerInvariant())">
                            <span class="round-number">round @round.RoundNumber</span>
                            <span class="outcome">@round.Outcome</span>
                            @if (round.Attempts > 1)
                            {
                                @* Only said when it took more than one. A round that needed asking
                                    for twice is a fact a reviewer wants; one that did not is noise. *@
                                <span class="attempts">@round.Attempts attempts</span>
                            }
                            @if (round.Failure is { } failure)
                            {
                                <span class="failure">@failure.ToString().ToLowerInvariant() failure</span>
                            }

                            @* The change itself, and the first thing on the card. This is the
                                diff a reviewer judges: git's own output, generated on the host
                                from the tree the round left, one entry per file with the counts
                                a reviewer needs before opening anything, and git's text for each
                                file underneath it unchanged. It comes from a column on the round
                                rather than out of the payload, because the payload is the
                                container's account of itself and is bounded — a board built on it
                                would show a prefix of a large change and read as though it were
                                all of it (story 34, ADR-0006, ADR-0011). *@
                            @{
                                var diff = Model.DiffOf(round);
                            }
                            @if (diff is { State: DiffState.Shown } or { State: DiffState.Empty } or { State: DiffState.Unfinished })
                            {
                                <section class="diff"
                                         data-diff="round @round.RoundNumber"
                                         data-state="@diff.State.ToString().ToLowerInvariant()"
                                         data-files="@diff.Files.Count"
                                         data-total-files="@diff.TotalFiles"
                                         data-omitted-files="@diff.OmittedFiles"
                                         data-omitted-lines="@diff.OmittedLines"
                                         data-tree="@diff.Tree">
                                    <h4 class="diff-heading">
                                        the change, from the tree this round left
                                    </h4>
                                    @if (Model.SaysAboutAnUnchangedDisk(diff) is { } unchanged)
                                    {
                                        @* Two different sentences for the same empty disk, and the difference
                                            is the round rather than the disk. "Unfinished" exists because a
                                            round whose agent was refused before it began reports the same
                                            unchanged tree as one that chose to change nothing, and calling
                                            the second thing the first is a confident false claim about a
                                            round that never started (#22). The payload beside it carries the
                                            exit code and whatever the provider said. *@
                                        <p class="diff-empty" data-diff-empty="round @round.RoundNumber">@unchanged</p>
                                    }
                                    else
                                    {
                                        <p class="diff-counts" data-diff-counts="round @round.RoundNumber">
                                            @diff.Files.Count of @diff.TotalFiles file(s) shown,
                                            @diff.TotalFiles file(s) in all.
                                        </p>
                                        @if (Model.WhatIsLeftOff(diff) is { } leftOff)
                                        {
                                            @* The bound is on whole files, never mid-hunk, and what was
                                                left off is counted rather than absorbed. A diff that
                                                stops without saying how much it stopped at is
                                                indistinguishable from a diff of a smaller change,
                                                which is the failure this whole rendering exists to
                                                prevent. *@
                                            <p class="diff-omitted" data-diff-omitted="round @round.RoundNumber">@leftOff</p>
                                        }
                                        @if (diff.BoundedElsewhere is { } bounded)
                                        {
                                            <p class="diff-bounded" data-diff-bounded="round @round.RoundNumber">@bounded</p>
                                        }
                                        <ol class="diff-files">
                                            @for (var at = 0; at < diff.Files.Count; at++)
                                            {
                                                var file = diff.Files[at];
                                                var isOpen = diff.IsOpenAt(at);
                                                <li class="diff-file">
                                                    @* Open for the first file and folded for the rest, so a card
                                                        shows the shape of the change and one file's actual
                                                        content without being a wall of text. Every file is
                                                        in the page either way: folded is one click, not
                                                        summarised away. *@
                                                    <details class="diff-file-details"
                                                             data-diff-file="@file.Path"
                                                             data-open-key="@($"{workItem.Id:N}/{round.RoundNumber}/{file.Path}")"
                                                             data-change="@file.Change.ToString().ToLowerInvariant()"
                                                             data-added="@file.Added"
                                                             data-removed="@file.Removed"
                                                             data-binary="@(file.Binary ? "true" : "false")"
                                                             data-open="@(isOpen ? "true" : "false")"
                                                             open="@(isOpen ? "open" : null)">
                                                        <summary>
                                                            <span class="path">@file.Path</span>
                                                            <span class="change">@file.Change.ToString().ToLowerInvariant()</span>
                                                            @if (file.PreviousPath is { Length: > 0 } from)
                                                            {
                                                                <span class="from">from @from</span>
                                                            }
                                                            @if (file.Binary)
                                                            {
                                                                @* Git writes no readable content for a binary change. That
                                                                    is a fact about the change rather than a gap in the
                                                                    record, and it is said on the line rather than shown
                                                                    as an empty body. *@
                                                                <span class="counts">binary, so no line counts</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="counts">+@file.Added −@file.Removed</span>
                                                            }
                                                        </summary>
                                                        <pre class="diff-text">@file.Text</pre>
                                                    </details>
                                                </li>
                                            }
                                        </ol>
                                    }
                                </section>
                            }
                            else if (diff is { } missing)
                            {
                                @* A diff that could not be generated says so, and says why. An
                                    absent section would read as a round that changed nothing, which
                                    is a different and much worse claim. *@
                                <section class="diff diff-unavailable"
                                         data-diff="round @round.RoundNumber"
                                         data-state="unavailable"
                                         data-tree="@diff.Tree">
                                    <h4 class="diff-heading">the change, from the tree this round left</h4>
                                    <p class="diff-none" data-diff-unavailable="round @round.RoundNumber">
                                        There is no diff for this round: @missing.UnavailableBecause
                                    </p>
                                </section>
                            }

                            @* What the round recorded about itself: the files it changed as its own
                                git saw them, the commands it ran and what each returned, and the
                                agent's own sentence. This is the container's account and it is
                                kept as the container's account — the diff above is a separate
                                observation, not a replacement for this one. *@
                            @if (round.ResultPayload is { Length: > 0 })
                            {
                                <details class="result-wrapper" data-result-wrapper="round @round.RoundNumber"
                                         open="@(diff is null ? "open" : null)">
                                    <summary class="result-heading">what the round's container recorded about itself</summary>
                                    <pre class="result" data-result="round @round.RoundNumber">@round.ResultPayload</pre>
                                </details>
                            }
                            @if (round.AgentNote is { Length: > 0 })
                            {
                                @* The only sentence a model wrote. Said after the observations on
                                    purpose: it is the one part of a result nothing above is
                                    derived from, so it reads as an account and not as a record. *@
                                <span class="note" data-note="round @round.RoundNumber">@round.AgentNote</span>
                            }
                            @if (round.Log is { Length: > 0 })
                            {
                                @* The round's log, kept with the round rather than only in the
                                    factory's own logging. A round whose result could not be read
                                    is a round whose only account of itself is this, so it is
                                    always rendered and never folded away by default. *@
                                <details class="round-log" open="@(round.ResultPayload is not { Length: > 0 })">
                                    <summary data-log="round @round.RoundNumber">the round's log</summary>
                                    <pre class="log">@round.Log</pre>
                                </details>
                            }
                        </li>
                    }
                </ol>
            }
            @if (decisions.Count > 0)
            {
                @* What the reviewer did and what they said, in every lane. *@
                <ol class="decided">
                    @foreach (var decision in decisions)
                    {
                        <li class="decision-made"
                            data-decision-made="@Decisions.Slug(decision.Decision)"
                            data-made-on="@workItem.Id"
                            data-feedback="@decision.Feedback"
                            data-applied-to="@decision.AppliedTo"
                            data-decided-utc="@decision.DecidedUtc.ToString("O")">
                            <span class="decision">@Decisions.Label(decision.Decision)</span>
                            @if (decision.AppliedTo is { } appliedTo)
                            {
                                @* Where the loop put the work item to apply this one. Said
                                    plainly, because it is the whole of what the decision did:
                                    an approval the loop could not carry out reads as applied
                                    to Review, which is how a change that was approved and
                                    not shipped stays visible after the page is re-read. *@
                                <span class="applied-to">applied to @Swimlanes.Label(appliedTo)</span>
                            }
                            @if (decision.Feedback is { Length: > 0 })
                            {
                                <span class="reviewer-words">@decision.Feedback</span>
                            }
                        </li>
                    }
                </ol>
            }
            @if (workItem.Swimlane == Swimlane.Review)
            {
                @* The review workspace: a second kind of container, and the board's one
                    write that is not a decision. What it is and what it may not do is on
                    the card, because a reviewer deciding whether to open one should not
                    have to trust the link blindly. *@
                var link = workspace?.Url;
                @if (workspace is { Error: { Length: > 0 } problem })
                {
                    <p class="workspace-error" data-workspace-error="@workItem.Id">the workspace could not be opened: @problem</p>
                }
                @if (link is { } url)
                {
                    <p class="workspace" data-workspace="@workItem.Id" data-workspace-url="@url">
                        <a href="@url">the review workspace</a>
                        @if (workspace?.Remaining is { } left)
                        {
                            <span data-workspace-remaining="@(Math.Max(0, (int)left.TotalMinutes)) minutes">ends in @(Math.Max(0, (int)left.TotalMinutes)) minutes</span>
                        }
                        — code-server on a copy of the round's tree, with the project's toolchain. No
                        credential inside, nothing here pushes, and it is reachable from this machine only;
                        the loopback is the gate. It ends on your decision, on the next round, or when its
                        lifetime runs out.
                    </p>
                }
                else if (workspace is not { Error: { Length: > 0 } })
                {
                    <form class="open-workspace" data-open-workspace="@workItem.Id" method="post"
                          action="/?handler=OpenWorkspace@(Model.Project is { Length: > 0 } filter ? $"&project={Uri.EscapeDataString(filter)}" : "")">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="workItemId" value="@workItem.Id" />
                        <button type="submit">open the review workspace</button>
                        <span class="workspace-note">code-server + the project's toolchain on a copy of this round's tree; this machine only; no credential inside</span>
                    </form>
                }
            }
            @{
                // The only form on the board, and the only write path there is. Rendered
                // wherever a reviewer can still act — Review, and a parked work item, which
                // offers the two decisions that finish it. A Rejected or Done work item
                // gets no form at all, because there is nothing left to decide.
                var offered = Model.DecisionsOffered(workItem.Swimlane);
            }
            @if (offered.Count > 0)
            {
                <form class="decide"
                      data-decide="@workItem.Id"
                      method="post"
                      action="/?handler=Decision@(Model.Project is { Length: > 0 } filter ? $"&project={Uri.EscapeDataString(filter)}" : "")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="workItem" value="@workItem.Id" />
                    <label class="feedback" for="feedback-@workItem.Id">Your reasons — the next round is handed them as its brief</label>
                    <textarea id="feedback-@workItem.Id" name="feedback" rows="4"></textarea>
                    <div class="decisions">
                        @foreach (var decision in offered)
                        {
                            <button type="submit"
                                    name="decision"
                                    value="@Decisions.Slug(decision)"
                                    data-decision="@Decisions.Slug(decision)">@Decisions.Label(decision)</button>
                        }
                    </div>
                </form>
            }
        </li>
    }
}
