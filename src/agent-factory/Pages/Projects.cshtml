@page "/Projects"
@model AgentFactory.Pages.ProjectsModel
@{
    ViewData["Title"] = "Projects";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="@FactoryConstants.BoardAutoRefreshSeconds" />
    <title>Projects — Agent Factory</title>
    <style>
        body { font-family: system-ui, sans-serif; margin: 2rem auto; max-width: 60rem; color: #1c1c1c; }
        h1 a { text-decoration: none; color: inherit; }
        table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
        th, td { text-align: left; padding: 0.4rem 0.8rem; border-bottom: 1px solid #ddd; font-size: 0.95rem; }
        code { background: #f2f2f2; padding: 0.1rem 0.3rem; border-radius: 3px; }
        form.inline { display: inline; }
        form.add, form.credential { margin: 1rem 0; padding: 1rem; border: 1px solid #ddd; border-radius: 6px; max-width: 40rem; }
        form.add label, form.credential label { display: block; margin-top: 0.6rem; font-size: 0.85rem; color: #444; }
        form.add input, form.credential input { width: 100%; padding: 0.35rem; margin-top: 0.15rem; box-sizing: border-box; }
        form.add button, form.credential button, form.inline button { margin-top: 0.6rem; padding: 0.35rem 0.9rem; }
        .notice { background: #eef7ee; border: 1px solid #bce0bc; padding: 0.5rem 0.8rem; border-radius: 6px; }
        .warning { background: #fdf3e7; border: 1px solid #ecd3ae; padding: 0.5rem 0.8rem; border-radius: 6px; }
        .refused { color: #8a3a00; font-size: 0.9rem; }
        footer { margin-top: 2rem; font-size: 0.85rem; color: #666; }
    </style>
</head>
<body>
    <h1><a href="/">Agent Factory</a> — projects</h1>

    @if (Model.Added is { Length: > 0 } added)
    {
        <p class="notice" data-added="@added">Wrote <code>factories/@(added).yaml</code>. Project files are read at start, so this project is served after a restart of the factory.</p>
    }
    @if (Model.Problem is { Length: > 0 } problem)
    {
        <p class="warning" data-problem>@problem</p>
    }

    <h2>Served projects</h2>
    @if (Model.Projects.Projects.Count == 0)
    {
        <p>None. Add one below — a project file is written into <code>factories/</code> and the factory serves it after a restart.</p>
    }
    else
    {
        <table>
            <thead>
                <tr><th>Name</th><th>Repository</th><th>Worker image</th><th>Model</th><th>Credentials</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var project in Model.Projects.Projects)
                {
                    <tr data-served-project="@project.Name"
                        data-repo-url="@project.RepoUrl"
                        data-worker-image="@project.WorkerImage"
                        data-llm-model="@project.LlmModel"
                        data-github-key="@project.GitHubKeyName"
                        data-llm-key="@project.LlmKeyName">
                        <td>@project.Name</td>
                        <td>@project.RepoUrl</td>
                        <td>@project.WorkerImage</td>
                        <td>@project.LlmModel</td>
                        <td>
                            github: <code>@project.GitHubKeyName</code> — @(Model.CredentialPresent(project.GitHubKeyName) ? "set" : "not set");
                            llm: <code>@project.LlmKeyName</code> — @(Model.CredentialPresent(project.LlmKeyName) ? "set" : "not set")
                        </td>
                        <td>
                            <form class="inline" method="post" action="/Projects?handler=Remove">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="name" value="@project.Name" />
                                <button type="submit">remove</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (Model.Projects.Rejections.Count > 0)
    {
        <h2>Refused files</h2>
        <ul class="refused">
            @foreach (var refusal in Model.Projects.Rejections)
            {
                <li data-refused-file="@refusal.FileName"><code>@refusal.FileName</code> — @refusal.Reason: @refusal.Message</li>
            }
        </ul>
    }

    <h2>Add a project</h2>
    @* Said here, on the surface where a repository is chosen, rather than left to a reader
        who has to find it: a project added through this page is a repository the factory
        will poll and, given a credential, open and merge real pull requests into. The
        examples in `worker/examples/` are deliberately outside `factories/`, so nothing in
        a checkout is served by accident (#23). *@
    <p class="notice">
        A project added here is <strong>served</strong>: the factory will poll its issues and,
        with the credential below, open and merge pull requests into it. Nothing is added by
        default — this checkout commits no project file — so a repository is only reached once
        you name it. Scope the token to that one repository.
    </p>
    <form class="add" method="post" action="/Projects?handler=Add">
        @Html.AntiForgeryToken()
        <label>Name <input name="name" required /></label>
        <label>Repository URL <input name="repoUrl" placeholder="https://github.com/owner/repo" required /></label>
        <label>Worker image <input name="workerImage" value="ghcr.io/nanisoft/agent-factory-worker:1" required /></label>
        <label>Model <input name="llmModel" placeholder="anthropic/claude-sonnet-4-5" required /></label>
        <label>GitHub credential name <input name="githubKeyName" placeholder="NEXUS_GITHUB_TOKEN" required /></label>
        <label>LLM credential name <input name="llmKeyName" placeholder="NEXUS_ANTHROPIC_API_KEY" required /></label>
        <button type="submit">write the project file</button>
    </form>

    <h2>Set a credential</h2>
    <form class="credential" method="post" action="/Projects?handler=Credential">
        @Html.AntiForgeryToken()
        <label>Credential name <input name="name" placeholder="NEXUS_ANTHROPIC_API_KEY" required /></label>
        <label>Value <input name="value" type="password" required /></label>
        <button type="submit">write the credential</button>
        <p>The value is written into the secrets directory and is never shown again — the page says whether a name has one, never what it is.</p>
    </form>

    <footer>Project files are read at start: a change here is served after a restart. The board remains the only surface where work is approved.</footer>
</body>
</html>
