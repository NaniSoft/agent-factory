<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgentFactory</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The board's stylesheet, copied to the output beside the assembly rather than left in
      wwwroot for the content root to find. The content root is a factory *data* directory
      (a temporary one in the test host, /app in the deployment) and never carries one, so
      `FactoryApp` names the web root as AppContext.BaseDirectory/wwwroot instead — which is
      exactly where `dotnet publish` and this both put it. Declared here because a file that
      is served but not published is a file that exists in development and 404s in
      production, which is #25's original failure one level down.
    -->
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
