<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    TargetFramework, Nullable, ImplicitUsings and IsPackable are in
    Directory.Build.props; this file says only what is true of the factory alone.
    Package versions are in Directory.Packages.props.

    This project is `AgentFactory.Web` and its root namespace is `AgentFactory`, which
    is the one place the two do not agree — and it is deliberate, not an oversight.
    Every existing `.cs` file declares `namespace AgentFactory.Loop`,
    `AgentFactory.Rounds` and so on, and the split moves code, so the convention it is
    establishing is *namespace = project name*: Domain, Application and Infrastructure
    all take their own names, and Web keeps `AgentFactory` so that the move does not
    have to be a rename at the same time. When the composition root is the last thing
    left here (#81), this becomes `AgentFactory.Web` along with everything else.

    Until then every `.cs` file in this project still lives in Web, which is exactly
    where a slice ticket moves code *from*.
  -->

  <PropertyGroup>
    <RootNamespace>AgentFactory</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentFactory.Infrastructure\AgentFactory.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Temporalio" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Anything already under `wwwroot` — the project's own content, copied to the output
      beside the assembly rather than left for the content root to find. The content root
      is a factory *data* directory (a temporary one in the test host, /app in the
      deployment) and never carries one, so `FactoryApp` names the web root as
      AppContext.BaseDirectory/wwwroot instead — which is exactly where `dotnet publish`
      and this both put it. Declared here because a file that is served but not published
      is a file that exists in development and 404s in production. This is also the item
      that carries the Board export the target below copies in.
    -->
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The Board app's static export, put into this project's `wwwroot` cone as an explicit
    build step.

    The app is a flat Next export at the repository root (`../../admin`), built with
    `pnpm build` into `admin/out`; `FactoryApp` serves everything under
    AppContext.BaseDirectory/wwwroot. `Link` maps each exported file to the root of
    wwwroot (its `admin/out` cone is stripped), and the two copy flags put it in the
    output and in the published output, because a file that is served but not published
    is a file that exists in development and 404s in production.

    **It is a target rather than a bare `Content Include` glob, and the difference is
    the point.** A glob is evaluated silently: a checkout that has not run `pnpm build`
    contributes an empty item list, the build succeeds, and the only thing that says the
    Board is missing is a 404 in production. Here the glob is evaluated where it can be
    checked, and an empty one is a named warning that tells the operator to run
    `pnpm build` — the failure is said out loud rather than left to be discovered. The
    build still succeeds, so `dotnet build` never depends on the Node toolchain having
    been run: the export is content, and a factory without a Board still runs.
  -->
  <Target Name="CopyTheBoardsExport" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <BoardExport Include="$(MSBuildThisFileDirectory)..\..\admin\out\**" />
    </ItemGroup>

    <Warning Condition="'@(BoardExport)' == ''"
             Text="The Board app's static export was not found under admin/out, so the factory will serve no Board. Run `pnpm build` in admin/ and build again; this build continues without one." />

    <ItemGroup>
      <Content Include="@(BoardExport)"
               Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
               CopyToOutputDirectory="PreserveNewest"
               CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>