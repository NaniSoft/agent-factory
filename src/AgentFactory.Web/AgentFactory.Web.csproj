<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    TargetFramework, Nullable, ImplicitUsings and IsPackable are in
    Directory.Build.props; this file says only what is true of the factory alone.
    Package versions are in Directory.Packages.props.

    This project is `AgentFactory.Web` and its root namespace is `AgentFactory`, and
    that is no longer a temporary state: #81 owns the decision and it is to stay.

    The convention the slices established is *namespace = project name* — Domain,
    Application and Infrastructure each take their own — and what is left here is the
    one thing that convention cannot describe, because the process is not a slice. Two
    facts settle it. `Program`'s top-level statements are compiled into the global
    namespace and cannot be given one at all, so a rename would leave this project's
    own names in three places (`AgentFactory`, `AgentFactory.OpenApi`, and the global
    `Program`) instead of one. And `FactoryApp`/`BoardExport` are the *process's*
    names rather than a component's: `AgentFactory` is what "the whole factory in one
    process" is called, while `AgentFactory.Web` would name the thing that is not one.
    Everything a slice moved out of this project carries a namespace that says where it
    went; what stays carries the name of what it is.

    So this is where the composition root lives and stays. The registrations it used to
    hold in one long method are three modules under `Composition/` (#81), and what is
    left is the process's own surface — see `FactoryApp`'s own remarks for what Web owns
    and what the AppHost of [#63](https://github.com/NaniSoft/agent-factory/issues/63)
    will own.
  -->

  <PropertyGroup>
    <RootNamespace>AgentFactory</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentFactory.Infrastructure\AgentFactory.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
    <!--
      The OpenAPI document the Board's generated types are read from (#78, #80).
      The generator is registered here and *served* nowhere: `MapOpenApi()` is not
      called, so the process answers no document route and the document exists
      only as the build artefact `admin/scripts/generate-openapi-types.mjs` reads.
      The endpoints' own `.Produces<T>()` annotations are the schemas; this pair
      of packages is what turns them into a file.
    -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" />
  </ItemGroup>

  <!--
    **Generation is off on `Build`, and that is the whole of the store-of-record
    protection.** `Microsoft.Extensions.ApiDescription.Server` generates by
    launching the application's entry point with a mock server, and this
    application's entry point opens the SQLite store and reconciles orphaned
    rounds against it — against `data/agent-factory.db`, the record of record
    (ADR-0009), on every `dotnet build`. Turning it off here means a build cannot
    reach `data/` at all: the generation script invokes the target itself and is
    the one place `Factory__DatabasePath` is pointed at a temporary path, so the
    only thing that ever launches the entry point for a document is the step that
    has said where the store is. A build that quietly created or moved work items
    in the record of record is the failure this setting exists to make impossible.
  -->
  <PropertyGroup>
    <OpenApiGenerateDocumentsOnBuild>false</OpenApiGenerateDocumentsOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Anything already under `wwwroot` — the project's own content, copied to the output
      beside the assembly rather than left for the content root to find. The content root
      is a factory *data* directory (a temporary one in the test host, /app in the
      deployment) and never carries one, so `FactoryApp` names the web root as
      AppContext.BaseDirectory/wwwroot instead — which is exactly where `dotnet publish`
      and this both put it. Declared here because a file that is served but not published
      is a file that exists in development and 404s in production. This is also the item
      that carries the Board export the target below copies in.
    -->
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The Board app's static export, put into this project's `wwwroot` cone as an explicit
    build step.

    The app is a flat Next export at the repository root (`../../admin`), built with
    `pnpm build` into `admin/out`; `FactoryApp` serves everything under
    AppContext.BaseDirectory/wwwroot. `Link` maps each exported file to the root of
    wwwroot (its `admin/out` cone is stripped), and the two copy flags put it in the
    output and in the published output, because a file that is served but not published
    is a file that exists in development and 404s in production.

    **It is a target rather than a bare `Content Include` glob, and the difference is
    the point.** A glob is evaluated silently: a checkout that has not run `pnpm build`
    contributes an empty item list, the build succeeds, and the only thing that says the
    Board is missing is a 404 in production. Here the glob is evaluated where it can be
    checked, and an empty one is a named warning that tells the operator to run
    `pnpm build` — the failure is said out loud rather than left to be discovered. The
    build still succeeds, so `dotnet build` never depends on the Node toolchain having
    been run: the export is content, and a factory without a Board still runs.
  -->
  <Target Name="CopyTheBoardsExport" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <BoardExport Include="$(MSBuildThisFileDirectory)..\..\admin\out\**" />
    </ItemGroup>

    <Warning Condition="'@(BoardExport)' == ''"
             Text="The Board app's static export was not found under admin/out, so the factory will serve no Board. Run `pnpm build` in admin/ and build again; this build continues without one." />

    <ItemGroup>
      <Content Include="@(BoardExport)"
               Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
               CopyToOutputDirectory="PreserveNewest"
               CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>