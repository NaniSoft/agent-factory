<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Everything that reaches outside: `SqliteWorkItemStore`, `GitHubClient`, `ProcessCli`,
    `RoundRunner`, `HostDiffReader`, `SystemClock`, the Temporal driver, the OpenTelemetry
    wiring. It points at Application because an adapter is written to a port the inside
    declared, and at nothing beyond it — which is why an adapter here may hold a
    transport, a credential reader or a disk while Application holds none of those
    (docs/architecture.md, "The dependency rule").

    Everything else shared is in Directory.Build.props. Package versions are in
    Directory.Packages.props.
  -->

  <PropertyGroup>
    <RootNamespace>AgentFactory.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentFactory.Application\AgentFactory.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      `ProjectFileLoader` parses the YAML a human wrote in `factories/`, and
      `FactoryPaths`/`FactorySettings` read the configuration section that says where
      `factories/` is. All three are things this project reaches outside to get, which is
      what an adapter is; `Application` reaches for neither.
    -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="YamlDotNet" />

    <!--
      The same reference `Application` takes, and for the same reason on this side of the
      line: `RoundResultDeriver` reads a round's result file and says out loud what it
      could not read, which is `ILogger<T>` and nothing else — the constructor that pin
      names is the whole of the deriver's dependency list. The Web SDK carries this package
      implicitly and `Microsoft.NET.Sdk` does not, so it is declared rather than assumed.
    -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The Temporal driver: `TicketActivities` (the activities' implementation),
      `TicketWorkflow` (the durable state machine and its own input/response shapes),
      `TemporalTickets` (the starter and the worker host) and `NullTicketStarter` (the
      no-op for store-only mode). Adapters over the engine and over the policy core, which
      is why they are here and `ITicketActivities`/`ITicketStarter` are in `Application`.
    -->
    <PackageReference Include="Temporalio" />
    <!--
      `TemporalTickets` is a `BackgroundService` and resolves the store, the policy core
      and its own logger from the container as it hosts the worker. Both are the same kind
      of reference `Application` takes: the framework's own contract for being run and
      stopped, and the container's own abstraction for being asked for something — not a
      transport, a disk, a process or a credential.
    -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>