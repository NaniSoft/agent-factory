{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "AgentFactory.App.Fleet.OpenCodeEngine": "Information",
      "AgentFactory.App.Fleet.FleetRunner": "Information"
    }
  },
  "AllowedHosts": "*",
  "Fleet": {
    "PlaygroundRepo": "DurgaPrasadReddyV/demofactory-playground",
    "BaseBranch": "main",
    "CloneRoot": "data/clones",
    "WorktreeRoot": "data/worktrees",
    "DataDir": "data",
    "PollIntervalSeconds": 60,
    "OrgRescanMinutes": 15,
    "AllIntakeBacklogCap": 20,
    "ServerPort": 48180,
    "SessionTimeoutMinutes": 30,
    "ProbeTimeoutSeconds": 90,
    "MaxConcurrentRuns": 1,
    "OptInLabel": "agent-factory"
  }
}
