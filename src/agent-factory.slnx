<Solution>
  <Project Path="AgentFactory.Domain/AgentFactory.Domain.csproj" />
  <Project Path="AgentFactory.Application/AgentFactory.Application.csproj" />
  <Project Path="AgentFactory.Infrastructure/AgentFactory.Infrastructure.csproj" />
  <Project Path="AgentFactory.Web/AgentFactory.Web.csproj" />
  <Project Path="agent-factory.tests/agent-factory.tests.csproj" />
  <!--
    The fast layer: unit tests over `Domain` and `Application` alone (#86). Like the AppHost
    below, its path reaches out of `src/`, because `src/` is the factory and
    `ArchitectureTests.TheFactoryProjects` asserts the set of projects in it is exactly the
    factory's four. It is in the solution so that `dotnet build src/agent-factory.slnx` builds
    and verifies it like everything else. See its own project file and
    `docs/architecture.md`'s Testing section.
  -->
  <Project Path="../agent-factory.unit-tests/agent-factory.unit-tests.csproj" />
  <!--
    The Aspire AppHost (#63). It is here so that `dotnet build src/agent-factory.slnx` builds
    and verifies it like everything else. Its path is written out relative to the solution
    rather than moved into `src/`, because `src/` is the factory — `ArchitectureTests` reads
    one project per directory there and asserts the graph is exactly four edges — and the
    AppHost is the host, not one of the four. The fast-layer project above reaches out of
    `src/` for the same reason. See
    `apphost/AgentFactory.AppHost/AgentFactory.AppHost.csproj`.
  -->
  <Project Path="../apphost/AgentFactory.AppHost/AgentFactory.AppHost.csproj" />
</Solution>
