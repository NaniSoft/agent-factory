<Solution>
  <Project Path="AgentFactory.Domain/AgentFactory.Domain.csproj" />
  <Project Path="AgentFactory.Application/AgentFactory.Application.csproj" />
  <Project Path="AgentFactory.Infrastructure/AgentFactory.Infrastructure.csproj" />
  <Project Path="AgentFactory.Web/AgentFactory.Web.csproj" />
  <Project Path="agent-factory.tests/agent-factory.tests.csproj" />
  <!--
    The Aspire AppHost (#63). It is the one project outside `src/`, and it is here so that
    `dotnet build src/agent-factory.slnx` builds and verifies it like everything else. Its
    path is written out relative to the solution rather than moved into `src/`, because
    `src/` is the factory — `ArchitectureTests` reads one project per directory there and
    asserts the graph is exactly four edges — and the AppHost is the host, not one of the
    four. See `apphost/AgentFactory.AppHost/AgentFactory.AppHost.csproj`.
  -->
  <Project Path="../apphost/AgentFactory.AppHost/AgentFactory.AppHost.csproj" />
</Solution>
