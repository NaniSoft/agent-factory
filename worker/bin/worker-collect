#!/usr/bin/env bash
#
# The collector: turns what a round's container observed into one result file.
#
# ADR-0011 is the whole of this script. Everything here is an *observation*: the files git
# saw, the commands the recording wrapper ran and what each returned, the sockets that
# were listening, and the agent's one optional sentence copied raw. Nothing asks the agent
# anything, and nothing decides what a test failure means.
#
# Two channels leave a round and this file is one of them (ADR-0010). It is JSON *lines*
# — one self-contained object per line — so that a truncated result costs the tail and
# nothing else, and so that a record written while the host is reading costs that record
# rather than the file. Line 1 is always the header, which is how a round that produced
# nothing else is still not invisible (story 29).
#
# It runs from the entrypoint after the round ends, and on its own (`worker-round
# collect`) for a round that has already ended by some other route.

set -uo pipefail

. /usr/local/lib/agent-factory/json.sh

work="${AGENT_FACTORY_WORK:-/work}"
out="${AGENT_FACTORY_OUT:-/out}"
result="${AGENT_FACTORY_RESULT:-$out/result.json}"
log="${AGENT_FACTORY_COMMAND_LOG:-$out/commands.ndjson}"
note="${AGENT_FACTORY_NOTE:-$out/note.md}"

# How much of one observation is kept. A bound here is a *tail* rather than an error: the
# whole change is on the round's tree on the host and the board says when it read one.
git_bytes="${AGENT_FACTORY_GIT_TAIL_BYTES:-1048576}"

# The round's own exit code, handed in by the entrypoint that watched for it. Absent means
# the round has not said how it ended, and `null` says exactly that — reading a missing
# field as a failure would be guessing, and guessing here parks a work item that was about
# to work (#22).
round_exit="${AGENT_FACTORY_ROUND_EXIT_CODE:-}"

began_ms="$(json_epoch_ms)"

# --- helpers -------------------------------------------------------------------

# Emit one `git` record: a field's name, the bytes it really was, and its tail. `truncated`
# is carried because the host renders a card saying the diff it is showing is bounded,
# and a reviewer who notices is owed the answer rather than a guess.
git_record() {
    local field="$1"

    # Read to a file rather than into a variable, and the reason is exactness rather than
    # tidiness: `$(cat)` strips trailing newlines, so a byte count taken from it would be
    # one short for every observation that ends in one — which is every one of them, since
    # git's output always does. A `byteLength` that is wrong by one is a field the board
    # renders, and a bound that is off by one per observation is not the bound the host
    # thinks it applied.
    local scratch
    scratch="$(mktemp "${TMPDIR:-/tmp}/collect.XXXXXX")" || scratch=''
    if [ -n "$scratch" ]; then
        cat > "$scratch" 2>/dev/null
    else
        cat > /dev/null
    fi

    local bytes=0 truncated=false escaped=''
    if [ -n "$scratch" ]; then
        bytes=$(wc -c < "$scratch" | tr -d ' ') || bytes=0
        if [ "$bytes" -gt "$git_bytes" ]; then
            truncated=true
            escaped="$(tail -c "$git_bytes" "$scratch" | json_string)"
        else
            escaped="$(json_string < "$scratch")"
        fi
        rm -f "$scratch"
    else
        escaped='""'
    fi

    # Escaped from the file, never from a variable holding its contents: `$(...)` would
    # have stripped the trailing newlines git wrote, so the recorded text and the recorded
    # byte count would be two statements about different bytes. A diff that ends without a
    # newline is a diff that reads as truncated.
    printf '{"kind":"git","field":%s,"byteLength":%d,"truncated":%s,"text":%s}\n' \
        "$(json_lit "$field")" "$bytes" "$truncated" "$escaped"
}

# The header is always line 1, so it is written first and separately rather than being
# gathered with the rest. A result whose header is missing is a result the host cannot
# read at all, and the host says so; one whose header is third says the same thing for a
# reason nobody can diagnose.
write_header() {
    local start_head="${AGENT_FACTORY_START_HEAD:-}"

    local is_repo=false branch='' head='' remotes=''
    if [ -d "$work/.git" ] || git -C "$work" rev-parse --git-dir >/dev/null 2>&1; then
        is_repo=true
        branch=$(git -C "$work" rev-parse --abbrev-ref HEAD 2>/dev/null) || branch=''
        head=$(git -C "$work" rev-parse HEAD 2>/dev/null) || head=''
        [ -n "$start_head" ] || start_head=$(git -C "$work" rev-parse HEAD 2>/dev/null) || start_head=''
    fi

    # The names of credential-shaped variables and **never their values**. This is the
    # evidence a reviewer checks rather than a claim the board repeats: a round that was
    # handed something write-capable is visible in the record, and one that was not is
    # visible too (ADR-0006).
    #
    # Read into an array rather than expanded unquoted. Variable *names* cannot contain a
    # glob character, so nothing here can actually expand — but an unquoted expansion whose
    # safety depends on that is a hazard in a script whose whole subject is a stranger's
    # environment, and the array costs one line.
    local creds=()
    while IFS= read -r name; do
        [ -n "$name" ] && creds+=("$name")
    done < <(env | LC_ALL=C sed -n -E 's/^([A-Za-z_][A-Za-z0-9_]*)=.*/\1/p' \
        | LC_ALL=C grep -E -i '(^|_)(API_?KEY|TOKEN|SECRET|PASSWORD|CREDENTIAL|AUTH|PRIVATE_?KEY)($|_)' \
        | LC_ALL=C sort -u)

    printf '{"kind":"result","schema":%s,' \
        "$(json_lit "${AGENT_FACTORY_SCHEMA:-agent-factory/worker-result@1}")"
    printf '"roundExitCode":%s,' \
        "$([ -n "$round_exit" ] && printf '%s' "$round_exit" || printf 'null')"
    printf '"work":%s,"out":%s,' "$(json_lit "$work")" "$(json_lit "$out")"
    printf '"gitRepo":%s,' "$([ "$is_repo" = true ] && printf true || printf false)"
    printf '"head":%s,"branch":%s,"startHead":%s,' \
        "$(json_lit "$head")" "$(json_lit "$branch")" "$(json_lit "$start_head")"
    printf '"user":%s,"uid":%d,' "$(json_lit "$(id -un 2>/dev/null)")" "$(id -u 2>/dev/null || printf -- '-1')"
    printf '"credentialEnvNames":%s,' "$(json_string_array "${creds[@]+"${creds[@]}"}")"
    printf '"git":%s,' "$(json_lit "$(git --version 2>/dev/null | head -1)")"
    printf '"opencode":%s,' "$(json_lit "$(opencode --version 2>/dev/null | tr -d '\r' | head -1)")"
    printf '"codeServer":%s,' "$(json_lit "$(code-server --version 2>/dev/null | tr -d '\r' | grep -E -v '^(Server|User|Extension|App|IDE|Address|Port|Auth)' | head -1)")"
    printf '"os":%s,"kernel":%s}\n' \
        "$(json_lit "$(. /etc/os-release 2>/dev/null && printf '%s' "${PRETTY_NAME:-}")")" \
        "$(json_lit "$(uname -sr 2>/dev/null)")"
}

# --- what a round leaves listening --------------------------------------------
#
# `opencode` starts a background service that binds a loopback port inside the container.
# Nothing publishes it, so it is unreachable from the host — but it *is* a listening
# socket, and this image does not assume there are none. Anything found is recorded, so
# "publishes no ports" is a fact a reviewer can read rather than a claim the Dockerfile
# makes about itself.
listeners() {
    local f count
    for f in /proc/net/tcp /proc/net/tcp6; do
        [ -r "$f" ] || continue
        count=$(awk 'NR>1 && $4=="0A"' "$f" 2>/dev/null | wc -l | tr -d ' ')
        if [ "${count:-0}" -gt 0 ]; then
            printf '{"kind":"listener","field":%s,"count":%d,"text":%s}\n' \
                "$(json_lit "$f")" "$count" \
                "$(awk 'NR>1 && $4=="0A"' "$f" 2>/dev/null | json_string)"
        fi
    done
    return 0
}

# --- write it ------------------------------------------------------------------
#
# The result file is created and truncated *before* the first record, and every record is
# appended to it. This ordering is the whole difference between a result file and a stream
# of records on stdout: the collector runs at the end of a round whose stdout goes to
# `docker logs`, so a record written to stdout would be in the container's log and nowhere
# the host lifts the result from — and `docker cp` of a file nobody wrote succeeds,
# producing a round that ran, changed the repository, and reported nothing at all.

mkdir -p "$(dirname "$result")" 2>/dev/null || {
    printf 'worker-collect: cannot make a directory for %s, so this round returns nothing the host can read\n' \
        "$result" >&2
    exit 70
}

: > "$result" 2>/dev/null || {
    printf 'worker-collect: cannot write %s, so this round returns nothing the host can read\n' "$result" >&2
    exit 70
}

# Line 1, always. The host reads the header first and says so when it is missing, but only
# because everything after it is optional — a result whose header is third is a result
# whose first two records are git output, and a reader has no way to tell that from a
# result that began with two commands.
write_header >> "$result"

# The commands, verbatim from the wrapper. Copied rather than re-derived: the wrapper
# observed them while they ran, and re-running anything here could only observe the round
# twice.
if [ -s "$log" ]; then
    cat "$log" >> "$result"
fi

# The git observations. `diffFromRoundStart` is the diff against the commit the round
# started at, so it covers committed and uncommitted work alike — which is what makes it
# the diff the reviewer judges rather than only the part the round remembered to commit.
if git -C "$work" rev-parse --git-dir >/dev/null 2>&1; then
    start_head="${AGENT_FACTORY_START_HEAD:-$(git -C "$work" rev-parse HEAD 2>/dev/null)}"

    # Porcelain v2 with untracked files listed. A file the round committed is clean here
    # and visible in the diff; an untracked scratch file is the reverse. Reading either
    # alone silently drops half of what a reviewer judges.
    git -C "$work" status --porcelain=v2 --untracked-files=all 2>/dev/null | git_record status >> "$result"

    if [ -n "$start_head" ]; then
        git -C "$work" diff "$start_head" 2>/dev/null | git_record diffFromRoundStart >> "$result"
        git -C "$work" log --format='%H %s' "$start_head"..HEAD 2>/dev/null | git_record commitsSinceRoundStart >> "$result"
    else
        # No base commit — a repository with no commits, or one whose start could not be
        # read. The staged and unstaged halves are recorded separately rather than
        # concatenated, so a reader can tell which comparison they are looking at.
        git -C "$work" diff --cached 2>/dev/null | git_record diffStaged >> "$result"
        git -C "$work" diff 2>/dev/null | git_record diffUnstaged >> "$result"
    fi

    # The remotes, which is where ADR-0006 becomes checkable: an empty list is a round
    # that had nowhere to push, whatever credential it did or did not hold.
    git -C "$work" remote -v 2>/dev/null | git_record remotes >> "$result"
fi

listeners >> "$result"

# The agent's one optional sentence. Copied raw and believed about nothing: a model that
# claims it edited a file it did not edit changes nothing, because git is what says which
# files changed.
if [ -s "$note" ]; then
    printf '{"kind":"note","field":"note","byteLength":%d,"text":%s}\n' \
        "$(wc -c < "$note" | tr -d ' ')" \
        "$(json_string < "$note")" >> "$result"
fi

# How many command records the log holds, as a plain integer.
#
# Not `[ -s "$log" ] && grep -c ... || printf 0`. That expression is wrong in a way that
# only shows up on a damaged log: `grep -c` prints `0` *and* exits non-zero when it counts
# nothing, so the `||` fires and prints a second `0`, and the record is written as
# `"commandRecords":0` followed by a line reading `0}`. The result file is JSON *lines* —
# that second line is not a record at all, and the host counts it as one it could not read.
# A truncated command log is a case the file is built to survive, and this is the one place
# that turned it into a truncated result too.
command_count() {
    if [ -s "$1" ]; then
        grep -c '"kind":"command"' "$1" 2>/dev/null || printf '0'
    else
        printf '0'
    fi
}

ended_ms="$(json_epoch_ms)"
printf '{"kind":"end","collectedInMs":%d,"commandRecords":%d}\n' \
    "$(( ended_ms - began_ms ))" "$(command_count "$log")" >> "$result"

printf 'worker-collect: wrote %s\n' "$result"