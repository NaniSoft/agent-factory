<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TargetFramework, Nullable, ImplicitUsings and IsPackable are in
    Directory.Build.props. `IsTestProject` is this project's alone: it is what
    makes the SDK publish nothing and hand the assembly to the runner.
    Package versions are in Directory.Packages.props.
  -->

  <PropertyGroup>
    <RootNamespace>AgentFactory.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Temporalio" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!--
      The OpenTelemetry SDK, and the one piece of it a test needs to be able to *watch* the
      process's telemetry pipeline rather than assert that a line of configuration exists
      (#63). `Observability/ExportedMetrics` is a `BaseExportingMetricReader` over a collector,
      contributed to the same `MeterProvider` the factory builds — so the assertion is about a
      measurement that reached an exporter, not about a call somebody made. See
      `Observability/TelemetryPipelineTests` for the claim and for the control that proves the
      assertion can see an absence. `Web` already takes the rest of the SDK; this is the same
      train, the same version, and it is a test-only reference.
    -->
    <PackageReference Include="OpenTelemetry" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentFactory.Web\AgentFactory.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>